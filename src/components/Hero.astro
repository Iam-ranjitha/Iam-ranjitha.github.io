---
import { profile, initials, numbers, phoneDisplay } from '../lib/content';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="wash w1" aria-hidden="true"></div>
  <div class="wash w2" aria-hidden="true"></div>
  <div class="wash w3" aria-hidden="true"></div>

  <div class="wrap copy">
    <div class="top">
      <div class="avatar">
        {
          profile.photo ? (
            <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="112" height="112" />
          ) : (
            <span aria-hidden="true">{initials}</span>
          )
        }
      </div>
      <ul class="meta">
        <li><Icon name="pin" /> {profile.location}</li>
        {
          profile.phone && (
            <li>
              <Icon name="phone" /> <a href={`tel:${profile.phone}`}>{phoneDisplay}</a>
            </li>
          )
        }
      </ul>
    </div>

    <h1>{profile.name}</h1>
    <p class="role">{profile.role} at {profile.company}</p>
    <p class="tagline">{profile.tagline}</p>
    <ul class="tags" aria-label="Focus areas">
      {profile.focus.map((f) => <li class="chip">{f}</li>)}
    </ul>
    <p class="inbox">{profile.inboxLine}</p>
    <div class="cta">
      <a class="btn btn-primary" href="#contact"><Icon name="mail" /> Get in touch</a>
      <a class="btn btn-ghost" href="/cv/">View CV</a>
      <ul class="social" aria-label="Find me online">
        <li>
          <a href={profile.links.linkedin} aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
        </li>
        <li>
          <a href={profile.links.github} aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
        </li>
      </ul>
    </div>

    <dl class="numbers">
      {
        numbers.map((n) => (
          <div>
            <dt>{n.label}</dt>
            <dd>{n.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 6vw, 72px) 0 clamp(40px, 6vw, 72px);
  }
  .wash {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    pointer-events: none;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .w1 {
    width: 460px;
    height: 460px;
    background: #9bbcf0;
    top: -140px;
    right: -80px;
  }
  .w2 {
    width: 380px;
    height: 380px;
    background: var(--terra-tint);
    bottom: -120px;
    left: -100px;
    animation-delay: -6s;
  }
  .w3 {
    width: 320px;
    height: 320px;
    background: var(--navy-tint);
    top: 40%;
    left: 55%;
    animation-delay: -11s;
  }
  @keyframes drift {
    to {
      transform: translate(30px, 24px) scale(1.08);
    }
  }
  .copy {
    position: relative;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: clamp(22px, 4vw, 36px);
  }
  .avatar {
    flex: none;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    overflow: hidden;
    border: 5px solid var(--card);
    box-shadow:
      0 0 0 3px var(--navy-tint),
      0 18px 36px -20px rgba(18, 37, 74, 0.5);
    background: var(--navy-tint);
    display: grid;
    place-items: center;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .avatar span {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 600;
    color: var(--ink);
  }
  .meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .meta li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .meta :global(svg) {
    color: var(--navy);
    flex: none;
  }
  .meta a {
    color: inherit;
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--terra);
  }
  h1 {
    font-size: clamp(2.8rem, 8vw, 5.6rem);
    letter-spacing: -0.025em;
  }
  .role {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    color: var(--navy);
    margin: 14px 0 14px;
  }
  .tagline {
    max-width: 62ch;
    font-size: 1.15rem;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 20px 0 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags .chip:nth-child(3n + 2) {
    background: var(--gold-tint);
  }
  .tags .chip:nth-child(3n) {
    background: var(--terra-tint);
  }
  .inbox {
    max-width: 62ch;
    margin: 0 0 22px;
    padding: 4px 0 4px 18px;
    border-left: 4px solid var(--terra);
    font-size: 1.3rem;
    color: var(--ink);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .social {
    list-style: none;
    padding: 0;
    margin: 0 0 0 6px;
    display: flex;
    gap: 10px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--card);
    border: 1.5px solid var(--line);
    color: var(--navy);
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .social a:hover {
    background: var(--navy);
    color: #fff;
    transform: translateY(-2px);
  }
  .numbers {
    margin: clamp(36px, 6vw, 60px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .numbers div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 18px 20px;
  }
  .numbers dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    font-weight: 600;
    color: var(--terra);
    line-height: 1.1;
  }
  .numbers dt {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.35;
    margin-top: 4px;
  }
  @media (max-width: 860px) {
    .numbers {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .avatar {
      width: 88px;
      height: 88px;
    }
    .meta {
      font-size: 0.98rem;
    }
  }
</style>
