---
import { credentials, profile } from '../lib/content';
const { certifications, volunteering, education } = credentials;
---

<section class="block alt" id="credentials">
  <div class="wrap">
    <p class="kicker">Credentials and community</p>
    <h2>Certified, learning, and giving back</h2>

    <div class="grid">
      <div class="card">
        <h3>Certifications</h3>
        <ul class="plain">
          {
            certifications.map((c) => (
              <li>
                <strong>{c.url ? <a href={c.url}>{c.name}</a> : c.name}</strong>
                <span>{c.issuer}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card">
        <h3>Education</h3>
        <ul class="plain">
          {
            education.map((e) => (
              <li>
                <strong>{e.degree}</strong>
                <span>
                  {e.school} · {e.start}–{e.end}
                  {e.inProgress && ' · in progress'}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card wide">
        <h3>Volunteering</h3>
        <div class="vol">
          {
            volunteering.map((v) => (
              <div>
                <h4>{v.org}</h4>
                <ul class="plain">
                  {v.roles.map((r) => (
                    <li>
                      <strong>
                        {r.title}
                        {r.since && <span class="since"> · since {r.since}</span>}
                      </strong>
                      {r.detail && <span>{r.detail}</span>}
                      {r.links.length > 0 && (
                        <span class="links">
                          {r.links.map((l) => (
                            <a href={l.url}>{l.label}</a>
                          ))}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="card wide">
        <h3>Languages</h3>
        <ul class="langs">
          {
            profile.languages.map((l) => (
              <li class="chip">
                {l.name} <span>· {l.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .wide {
    grid-column: 1 / -1;
  }
  h3 {
    font-size: 1.35rem;
    margin-bottom: 16px;
  }
  h4 {
    font-family: var(--sans);
    font-size: 1.05rem;
    color: var(--terra);
    margin: 0 0 8px;
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .plain li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .plain li > span {
    color: var(--muted);
  }
  .since {
    font-weight: 400;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .links a {
    font-weight: 600;
  }
  .vol {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  .langs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .langs .chip {
    background: var(--gold-tint);
  }
  .langs .chip span {
    color: var(--muted);
    font-weight: 400;
  }
  @media (max-width: 760px) {
    .grid,
    .vol {
      grid-template-columns: 1fr;
    }
  }
</style>
