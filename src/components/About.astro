---
import { profile } from '../lib/content';
---

<section class="block" id="about">
  <div class="wrap">
    <p class="kicker">About</p>
    <h2>Structured delivery, clear reporting, strong relationships.</h2>
    <div class="text">
      {profile.about.map((p) => <p>{p}</p>)}
      <p class="off">{profile.offWork}</p>
    </div>
  </div>
</section>

<style>
  .text {
    max-width: 72ch;
  }
  .text p {
    font-size: 1.175rem;
  }
  .off {
    font-style: italic;
    color: var(--muted);
    margin-top: 28px;
  }
</style>
